{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices"],
  minimumReleaseAge: "7 days",
  lockFileMaintenance: {
    enabled: true,
  },
  labels: ["dependencies"],
  customManagers: [
    {
      customType: "regex",
      description: "Track the gh-actions-lock version used to verify the actions lockfile",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: ["gh extension install github/gh-actions-lock --pin (?<currentValue>v[^\\s]+)"],
      depNameTemplate: "github/gh-actions-lock",
      datasourceTemplate: "github-releases",
    },
    {
      // The wasm-bindgen CLI installed in CI and the Docker image must match
      // the wasm-bindgen crate's version exactly.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/.+\\.ya?ml$/", "/(^|/)Dockerfile$/"],
      matchStrings: [
        "tool: wasm-bindgen@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "ARG WASM_BINDGEN_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)",
      ],
      depNameTemplate: "wasm-bindgen-cli",
      datasourceTemplate: "crate",
      // The crate datasource defaults to cargo versioning, which would read a
      // bare 0.2.129 as ^0.2.129; these pins are exact versions.
      versioningTemplate: "semver",
    },
  ],
  packageRules: [
    {
      // .github/workflows/actions.lock pins action commits; gh actions-lock strips inline digests.
      description: "Use the actions lockfile instead of inline digest pins",
      matchManagers: ["github-actions"],
      pinDigests: false,
    },
    {
      // Bump the crate (pinned with "=" in Cargo.toml) and the CLI together.
      matchPackageNames: ["wasm-bindgen", "wasm-bindgen-cli"],
      groupName: "wasm-bindgen",
    },
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      minimumReleaseAge: null,
    },
    {
      matchCategories: ["ci"],
      addLabels: ["ci"],
    },
    {
      matchManagers: ["npm"],
      matchDepTypes: ["devDependencies"],
      addLabels: ["dev dependencies"],
      automerge: true,
    },
    {
      matchManagers: ["cargo"],
      addLabels: ["rust"],
    },
    {
      matchManagers: ["rust-toolchain"],
      matchDepTypes: ["toolchain"],
      addLabels: ["rust", "ci"],
    },
  ],
}
