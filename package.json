{
  "name": "procnote",
  "version": "0.0.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shunichironomura/procnote"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "pnpm run build:wasm && vp build",
    "build:launcher": "node scripts/prepare-launcher.mjs",
    "build:collab": "vp pack collab/main.ts -d collab/dist --no-config",
    "build:wasm": "node scripts/build-wasm.mjs",
    "collab": "node collab/dist/main.mjs",
    "preview": "vp preview",
    "tauri": "node scripts/tauri.mjs",
    "check": "tsc --noEmit",
    "vp:check": "vp check",
    "vp:fix": "vp check --fix",
    "test": "vp test run"
  },
  "dependencies": {
    "@blocknote/core": "^0.56.0",
    "@blocknote/mantine": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@blocknote/server-util": "^0.56.0",
    "@hocuspocus/extension-database": "^4.7.1",
    "@hocuspocus/provider": "^4.7.1",
    "@hocuspocus/server": "^4.7.1",
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "idb-keyval": "^6.3.0",
    "marked": "^18.0.0",
    "marked-highlight": "^2.2.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.16.1"
